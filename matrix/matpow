template<typename T>
vector<vector<T>> matmul(vector<vector<T>> a, vector<vector<T>> b) {
    assert(b.size() == a[0].size());
    vector<vector<T>> ret(a.size(), vector<T>(b[0].size()));
    for (int i = 0; i < (int) a.size(); i++) {
        for (int j = 0; j < (int) b[0].size(); j++) {
            for (int k = 0; k < (int) a[0].size(); k++) {
                ret[i][j] += a[i][k] * b[k][j];
            }
        }
    }
    return ret;
}

template<typename T>
vector<vector<T>> matpow(vector<vector<T>> a, long long n) {
    vector<vector<T>> ret(a.size(), vector<T>(a[0].size()));
    for (int i = 0; i < (int) a.size(); i++) ret[i][i] = 1;
    while (n) {
        if (n & 1) ret = matmul(ret, a);
        a = matmul(a, a);
        n >>= 1;
    }
    return ret;
}

